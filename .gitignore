# Manuscript SOURCE under papers/ is tracked (see papers/cobordism-residual).
# Only the regenerable LaTeX build artifacts are ignored. main.bbl is
# deliberately NOT ignored: bibtex generates it, but arXiv requires it inside
# the submission tarball because arXiv does not run bibtex itself.
papers/**/*.aux
papers/**/*.log
papers/**/*.out
papers/**/*.blg
papers/**/*.synctex.gz
papers/**/*.fdb_latexmk
papers/**/*.fls
papers/**/main.pdf
refs/
third_party/itensor_tdvp/
.venv-build/
campaign-geometry
proton_dumps/
dumps

# #778 example run artifacts (never committed; see the issue-attachments release)
recursive_baryon_run*.json
recursive_baryon_campaign*.json
recursive_baryon_sidecar*.npz
recursive_baryon_overlay*.png

# #831 emergence animation artifacts. `run` defaults --out to
# emergence_animation.gif, so a bare invocation writes one into the working
# directory; this branch committed one by accident before the entry existed.
emergence_animation*.gif
emergence_animation*.mp4
emergence_animation*.png
emergence_animation*.json

run.sh
