// First interaction cell — 10-edge (2,3) Pachner 4-simplex.
//
// Two gen-0 vertices X, Y interact via U = exp(-i H_pair Δt) to
// produce three gen-1 vertices X', AB, Y'. The five vertices form a
// 4-simplex with 10 edges; the layout below shows them all
// distinguishable in 2D.
//
// Rendered with:   neato -n -Tsvg h_pair_first_cell_diagram.dot \
//                       -o h_pair_first_cell_diagram.svg
//
// The -n flag tells neato to honor the explicit `pos` attributes
// (in inches via inputscale=72) instead of running its own layout.
// Edge labels show ℓ = -ln(I/I_max) computed from the cell-2
// intermediate-engagement MI values from §8 of h_pair_first_cell.md.

graph FirstCell {
  // ---- global graph attributes ----
  graph [layout="neato", overlap="false", splines="line",
         bgcolor="white", margin="0.3", inputscale=72,
         label=<<FONT POINT-SIZE="16"><B>First interaction cell — 10 edges of the (2,3) Pachner 4-simplex</B></FONT><BR/><FONT POINT-SIZE="12">cell-2 values: <I>I</I><SUB>input</SUB>=0.160, <I>I</I><SUB>joint</SUB>=0.461, <I>S</I><SUB>X</SUB>=<I>S</I><SUB>Y</SUB>=0.080 nats  |  ℓ = -ln(<I>I</I>/<I>I</I><SUB>max</SUB>), <I>I</I><SUB>max</SUB>=2&#160;ln&#160;2</FONT>>,
         labelloc="t", fontsize=12];

  // ---- node defaults ----
  node [shape="circle", style="filled", fontname="Helvetica",
        fontsize=22, fontcolor="black", penwidth=1.5,
        width=0.8, fixedsize=true];
  edge [fontname="Helvetica", fontsize=12, labelfloat=false,
        decorate=false, penwidth=2.8];

  // ---- 5 vertices (positions in inches; figure ~13 × 6) ----
  X    [pos="0,5!",     fillcolor="#fcd34d", label="X"];
  Y    [pos="0,0!",     fillcolor="#fcd34d", label="Y"];
  "Xp" [pos="12,5!",    fillcolor="#a7f3d0", label=<X'>];
  "Yp" [pos="12,0!",    fillcolor="#a7f3d0", label=<Y'>];
  AB   [pos="6,3.5!",   fillcolor="#fda4af", shape="box",
        width=1.0, height=0.7, label="AB"];

  // ---- 4 pair-MI edges (blue, ℓ = 2.16) ----
  X    -- Y    [color="#1f77b4", fontcolor="#1f77b4",
                xlabel=<<I>I</I><SUB>input</SUB> &#160;ℓ=2.16>];
  "Xp" -- "Yp" [color="#1f77b4", fontcolor="#1f77b4",
                xlabel=<<I>I</I><SUB>input</SUB> &#160;ℓ=2.16>];
  X    -- "Yp" [color="#1f77b4", fontcolor="#1f77b4",
                taillabel=<<I>I</I><SUB>input</SUB><BR/>(cross)<BR/>ℓ=2.16>,
                labeldistance=4.5, labelangle=-25];
  Y    -- "Xp" [color="#1f77b4", fontcolor="#1f77b4",
                taillabel=<<I>I</I><SUB>input</SUB><BR/>(cross)<BR/>ℓ=2.16>,
                labeldistance=4.5, labelangle=25];

  // ---- 2 worldline self-info edges (green, ℓ = 2.85) ----
  X -- "Xp" [color="#2ca02c", fontcolor="#2ca02c", penwidth=3.5,
             xlabel=<<I>S</I><SUB>X</SUB> &#160;ℓ=2.85>];
  Y -- "Yp" [color="#2ca02c", fontcolor="#2ca02c", penwidth=3.5,
             xlabel=<<I>S</I><SUB>Y</SUB> &#160;ℓ=2.85>];

  // ---- 4 hub spokes (red, ℓ = 1.10) ----
  // Use head/taillabels so labels sit near AB rather than mid-edge.
  X    -- AB [color="#d62728", fontcolor="#d62728",
              headlabel=<<I>I</I><SUB>joint</SUB><BR/>ℓ=1.10>,
              labeldistance=2.5, labelangle=-20];
  Y    -- AB [color="#d62728", fontcolor="#d62728",
              headlabel=<<I>I</I><SUB>joint</SUB><BR/>ℓ=1.10>,
              labeldistance=2.5, labelangle=20];
  "Xp" -- AB [color="#d62728", fontcolor="#d62728",
              headlabel=<<I>I</I><SUB>joint</SUB><BR/>ℓ=1.10>,
              labeldistance=2.5, labelangle=-20];
  "Yp" -- AB [color="#d62728", fontcolor="#d62728",
              headlabel=<<I>I</I><SUB>joint</SUB><BR/>ℓ=1.10>,
              labeldistance=2.5, labelangle=20];

  // ---- generation captions (invisible nodes acting as labels) ----
  gen0_label [pos="0,5.9!", shape="plaintext", width=0, height=0,
              fontcolor="#854d0e", fontsize=12,
              label=<<I>generation 0</I><BR/>(initial layer)>];
  gen1_label [pos="12,5.9!", shape="plaintext", width=0, height=0,
              fontcolor="#065f46", fontsize=12,
              label=<<I>generation 1</I><BR/>(products)>];
  core_label [pos="6,2.3!", shape="plaintext", width=0, height=0,
              fontcolor="#9f1239", fontsize=10.5,
              label=<entangling core Σ<SUB>AB</SUB><BR/>(Choi state of <I>Û</I>)>];
}
